# ==============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy these into your host's environment settings (Render / Railway / Fly /
# Vercel / etc.) — do NOT commit a filled-in version. Every value below must be
# set explicitly; production should never fall back to a dev default.
#
# Generate each JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

NODE_ENV=production

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collabdocs?retryWrites=true&w=majority

# Use FRESH random secrets here — never reuse the dev values.
JWT_ACCESS_SECRET=<64-hex-random>
JWT_REFRESH_SECRET=<64-hex-random>

# ── Public URLs (MUST be your real https domains, no localhost) ────────────────
# Server reads these; the client needs NEXT_PUBLIC_API_URL at BUILD time.
CLIENT_URL=https://app.yourdomain.com
API_URL=https://api.yourdomain.com

# ── Email (Brevo HTTP API) ────────────────────────────────────────────────────
# IMPORTANT: many hosts (Render, Vercel, etc.) BLOCK outbound SMTP ports, so
# Gmail/SMTP will silently fail there. The Brevo API sends over HTTPS (443),
# which always works. When BREVO_API_KEY is set, the app uses it automatically.
#   1. Brevo → Settings → SMTP & API → API Keys → generate an API key (xkeysib-…).
#   2. Verify your sender address (Settings → Senders) and use it in SMTP_FROM.
# Free tier: 300 emails/day. (A verified custom domain greatly improves inbox
# delivery; a @gmail.com sender works but may land in spam.)
BREVO_API_KEY=xkeysib-<your-api-key>
SMTP_FROM=CollabDocs <your-verified-sender@example.com>

# Optional: absolute https URL to the logo shown in email headers.
# Defaults to <CLIENT_URL>/collabdocs-logo-full.png when CLIENT_URL is https.
# EMAIL_LOGO_URL=https://app.yourdomain.com/collabdocs-logo-full.png

# ── Password-reset OTP ────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Password strength ─────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Enforce email verification in production (SMTP is configured now).
REQUIRE_EMAIL_VERIFICATION=true

# ── Google OAuth ──────────────────────────────────────────────────────────────
# In Google Cloud Console, add the production callback to authorized redirect URIs:
#   https://api.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>

# ── AI (optional) ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-<your-key>
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Scaling (optional) ────────────────────────────────────────────────────────
# Only needed if you run MORE THAN ONE server instance, so per-IP rate limits
# are shared across instances. Single instance: leave unset (in-memory is fine).
# REDIS_URL=redis://default:<password>@<host>:<port>
