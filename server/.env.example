# ============================================
# DATABASE & CACHE
# ============================================

# MongoDB connection string
# Get free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/collabdocs

# Redis connection (for real-time sync across backend instances)
# Free tier: https://upstash.com (click "Create Database")
# Format: redis://default:password@host:port
REDIS_URL=redis://default:<password>@<host>:<port>

# ============================================
# AUTHENTICATION
# ============================================

# JWT Secrets (use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` to generate)
# Access token: short-lived (15 min), stored in memory on client
JWT_ACCESS_SECRET=your-256-bit-access-secret-here

# Refresh token: long-lived (7 days), stored in HttpOnly cookie
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-here

# Google OAuth (get credentials from https://console.cloud.google.com)
# Create project → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# AI & EXTERNAL SERVICES
# ============================================

# DeepSeek API (OpenAI-compatible)
# Sign up at https://platform.deepseek.com and copy your API key
# Used for writing suggestions, grammar, summarization
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# Model to use (deepseek-chat is deprecated July 2026; use the flash variant)
DEEPSEEK_MODEL=deepseek-v4-flash

# ============================================
# SERVER & CLIENT CONFIGURATION
# ============================================

# Port the backend runs on
PORT=4000

# Environment (development, staging, production)
NODE_ENV=development

# Log level for the pino structured logger: trace|debug|info|warn|error|fatal|silent
# Defaults to "info" (pretty-printed in dev, JSON in production, silent under test).
LOG_LEVEL=info

# Frontend URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:3000

# Backend API URL (used by frontend)
API_URL=http://localhost:4000

# ============================================
# EMAIL (Optional - leave blank for console fallback in dev)
# ============================================

# The mailer picks a transport automatically:
#   • If BREVO_API_KEY is set  → sends via Brevo's HTTP API (port 443). Use this
#     in PRODUCTION — many hosts (Render, Vercel) block outbound SMTP ports.
#   • Else if SMTP_* is set     → sends via SMTP (handy for local dev w/ Gmail).
#   • Else                      → logs the email to the console (dev fallback).
#
# Brevo (free, 300/day): create an account, verify a sender, then:
#   API key:  Settings → SMTP & API → API Keys → generate (xkeysib-…)
#   SMTP key: Settings → SMTP & API → SMTP → generate (xsmtpsib-…), login is
#             shown there as e.g. 12345@smtp-brevo.com
BREVO_API_KEY=

# SMTP (optional — local dev). For Gmail use an App Password; note Gmail/SMTP
# won't work on hosts that block SMTP ports (use BREVO_API_KEY there instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CollabDocs <your-verified-sender@example.com>

# Optional: absolute https URL of the logo in email headers.
# Defaults to <CLIENT_URL>/collabdocs-logo-full.png when CLIENT_URL is https.
# EMAIL_LOGO_URL=

# Password-reset OTP (one-time code emailed to the user)
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================
# SECURITY & VALIDATION
# ============================================

# Require users to verify their email before they can log in.
# Off by default so local dev (where SMTP may be unconfigured) isn't locked out.
# Turn on in production once SMTP_* is configured.
REQUIRE_EMAIL_VERIFICATION=false

# Password requirements (enforced on signup + password reset)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Input validation limits
MAX_TITLE_LENGTH=500
MAX_COMMENT_LENGTH=5000
MAX_DISPLAY_NAME=100
MAX_AI_INPUT=10000

# Request timeout (in milliseconds)
REQUEST_TIMEOUT=30000

# Session configuration
SESSION_TIMEOUT_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
