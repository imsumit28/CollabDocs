# ============================================
# DATABASE & CACHE
# ============================================

# MongoDB connection string
# Get free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/collabdocs

# Redis connection (for real-time sync across backend instances)
# Free tier: https://upstash.com (click "Create Database")
# Format: redis://default:password@host:port
REDIS_URL=redis://default:<password>@<host>:<port>

# ============================================
# AUTHENTICATION
# ============================================

# JWT Secrets (use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` to generate)
# Access token: short-lived (15 min), stored in memory on client
JWT_ACCESS_SECRET=your-256-bit-access-secret-here

# Refresh token: long-lived (7 days), stored in HttpOnly cookie
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-here

# Google OAuth (get credentials from https://console.cloud.google.com)
# Create project → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# AI & EXTERNAL SERVICES
# ============================================

# DeepSeek API (OpenAI-compatible)
# Sign up at https://platform.deepseek.com and copy your API key
# Used for writing suggestions, grammar, summarization
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# Model to use (deepseek-chat is deprecated July 2026; use the flash variant)
DEEPSEEK_MODEL=deepseek-v4-flash

# ============================================
# SERVER & CLIENT CONFIGURATION
# ============================================

# Port the backend runs on
PORT=4000

# Environment (development, staging, production)
NODE_ENV=development

# Frontend URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:3000

# Backend API URL (used by frontend)
API_URL=http://localhost:4000

# ============================================
# EMAIL (Optional - leave blank for console fallback in dev)
# ============================================

# Gmail SMTP settings (for email verification, password reset)
# Enable "Less secure app access" or use Google App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CollabDocs <noreply@collabdocs.app>

# ============================================
# SECURITY & VALIDATION
# ============================================

# Password requirements (enforce on signup)
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=false

# Input validation limits
MAX_TITLE_LENGTH=500
MAX_COMMENT_LENGTH=5000
MAX_DISPLAY_NAME=100
MAX_AI_INPUT=10000

# Request timeout (in milliseconds)
REQUEST_TIMEOUT=30000

# Session configuration
SESSION_TIMEOUT_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
