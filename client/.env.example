# ============================================
# PUBLIC API CONFIGURATION
# ============================================
# These are exposed to the browser (NEXT_PUBLIC_* prefix)

# Backend API URL for REST endpoints (/auth, /docs, /comments, etc.)
# Development: http://localhost:4000
# Production: https://api.collabdocs.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL for real-time collaboration (Socket.IO)
# Must be the same as API_URL (WebSocket connection to backend)
# Development: http://localhost:4000
# Production: https://api.collabdocs.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
